<?xml version="1.0" encoding="utf-8"?>
<!-- 诺基亚风格「发现新版本」提醒弹窗：与选项菜单同级的紧凑高度，
     内容区固定高度 + ScrollView 滚动展示，防止大字号下撑满/溢出屏幕 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ========== 标题栏 ========== -->
    <LinearLayout
        android:id="@+id/dialogTitleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keydroidx_dialog_title_bar_height"
        android:background="@drawable/bg_keydroidx_dialog_title"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发现新版本"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/keydroidx_dialog_title_text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========== 可滚动内容区（固定高度，与选项菜单整体高度相当） ========== -->
    <ScrollView
        android:id="@+id/dialogBody"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:background="@drawable/bg_keydroidx_dialog_body">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/dialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/keydroidx_dialog_body_text"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ========== 底部软键栏 ========== -->
    <LinearLayout
        android:id="@+id/dialogBottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keydroidx_dialog_title_bar_height"
        android:background="@drawable/bg_keydroidx_dialog_bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/softLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:text="更新"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/keydroidx_dialog_body_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/softRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:text="忽略此版本"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/keydroidx_dialog_body_text" />
    </LinearLayout>
</LinearLayout>
