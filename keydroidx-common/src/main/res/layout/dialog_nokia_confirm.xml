<?xml version="1.0" encoding="utf-8"?>
<!-- 标准诺基亚风格确认/提示弹窗布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ========== 标题栏 ========== -->
    <LinearLayout
        android:id="@+id/dialogTitleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nokia_dialog_title_bar_height"
        android:background="@drawable/bg_nokia_dialog_title"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提示"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_title_text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========== 内容提示区 ========== -->
    <LinearLayout
        android:id="@+id/dialogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nokia_dialog_body_confirm"
        android:gravity="center"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_title_text" />
    </LinearLayout>

    <!-- ========== 底部软键栏 ========== -->
    <LinearLayout
        android:id="@+id/dialogBottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nokia_dialog_title_bar_height"
        android:background="@drawable/bg_nokia_dialog_bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/softLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|start"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:text="确认"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_body_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/softRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:text="取消"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/nokia_dialog_body_text" />
    </LinearLayout>
</LinearLayout>
