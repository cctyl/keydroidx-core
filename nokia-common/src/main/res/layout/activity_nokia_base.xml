<?xml version="1.0" encoding="utf-8"?>
<!--
    诺基亚骨架布局：顶栏 + 内容区 + 底栏
    使用 weightSum 按屏幕高度比例分配，适配 240×320 / 320×480 等不同分辨率
    比例参考 HTML 原型：顶栏 28px / 320px ≈ 8.75%，底栏 26px / 320px ≈ 8.125%
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        顶部标题栏 (TitleBar)
        与 HTML 原型一致：左图标 + 标题 | 右状态(信号+电量)
        权重 7（≈7% 屏幕高度），背景由 NokiaTheme 运行时绘制渐变
    -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:orientation="horizontal"
        android:background="@color/nokia_top_bg">

        <!-- 标题图标 -->
        <TextView
            android:id="@+id/tvTitleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/nokia_top_text"
            android:textSize="16dp"
            android:visibility="gone" />

        <!-- 标题文字 -->
        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/nokia_top_text"
            android:textSize="16dp"
            android:textStyle="bold" />

        <!-- 右侧状态栏：信号图标 + 电量 -->
        <LinearLayout
            android:id="@+id/layoutStatusBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSignalIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#CBD5E1"
                android:textSize="14dp" />

            <ImageView
                android:id="@+id/tvBatteryIcon"
                android:layout_width="26dp"
                android:layout_height="16dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="1dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvBatteryPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:includeFontPadding="false"
                android:textColor="#CBD5E1"
                android:textSize="13dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中间内容区 (自适应充满，由业务布局填充) -->
    <FrameLayout
        android:id="@+id/midPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="85" />

    <!--
        底部三栏软键 (SoftkeyBar)
        与 HTML 原型一致：左键 | 中键(黄色) | 右键
        权重 8（≈8% 屏幕高度），背景由 NokiaTheme 运行时绘制渐变
    -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/nokia_bottom_bg">

        <TextView
            android:id="@+id/tvSoftLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|left"
            android:minHeight="30dp"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/nokia_bottom_text"
            android:textSize="11dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSoftCenter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="30dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#FDE047"
            android:textSize="11dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSoftRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|right"
            android:minHeight="30dp"
            android:paddingRight="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="@color/nokia_bottom_text"
            android:textSize="11dp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>