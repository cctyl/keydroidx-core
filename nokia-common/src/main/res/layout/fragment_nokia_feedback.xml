<?xml version="1.0" encoding="utf-8"?>
<!-- 诺基亚风格反馈页：设置页式单列行布局（FEATURE_PHONE_UI_SPEC §33/§34） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedbackScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nokia_page"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 行：问题类型（值选择器） -->
        <LinearLayout
            android:id="@+id/rowType"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_nokia_input_field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/lblType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="问题类型"
                android:textColor="#333333"
                android:textSize="@dimen/nokia_font_body" />

            <TextView
                android:id="@+id/valType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择 >"
                android:textColor="#AAAAAA"
                android:textSize="@dimen/nokia_font_caption" />
        </LinearLayout>

        <!-- 行：联系方式（文本输入） -->
        <LinearLayout
            android:id="@+id/rowContact"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_nokia_input_field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/lblContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="联系方式"
                android:textColor="#333333"
                android:textSize="@dimen/nokia_font_body" />

            <TextView
                android:id="@+id/valContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="130dp"
                android:singleLine="true"
                android:text="请输入 >"
                android:textColor="#AAAAAA"
                android:textSize="@dimen/nokia_font_caption" />
        </LinearLayout>

        <!-- 行：问题描述（文本输入） -->
        <LinearLayout
            android:id="@+id/rowComment"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_nokia_input_field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/lblComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="问题描述"
                android:textColor="#333333"
                android:textSize="@dimen/nokia_font_body" />

            <TextView
                android:id="@+id/valComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:text="请输入 >"
                android:textColor="#AAAAAA"
                android:textSize="@dimen/nokia_font_caption" />
        </LinearLayout>

        <!-- 行：附带日志（布尔开关，两行：副行显示日志状态） -->
        <LinearLayout
            android:id="@+id/rowLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nokia_input_field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/lblLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="附带运行日志"
                    android:textColor="#333333"
                    android:textSize="@dimen/nokia_font_body" />

                <TextView
                    android:id="@+id/tvLogInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="@dimen/nokia_font_caption" />
            </LinearLayout>

        </LinearLayout>

        <!-- 行：提交反馈（动作） -->
        <LinearLayout
            android:id="@+id/rowSubmit"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_nokia_input_field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/valSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="提 交 反 馈"
                android:textColor="#0055AA"
                android:textSize="@dimen/nokia_font_small_title" />
        </LinearLayout>

        <!-- 隐私说明 -->
        <TextView
            android:id="@+id/tvPrivacyNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:padding="8dp"
            android:text="提交将附带设备信息（品牌/型号/内存等）用于问题定位，不涉及个人隐私数据。"
            android:textColor="#999999"
            android:textSize="@dimen/nokia_font_caption" />

    </LinearLayout>
</ScrollView>
