<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:orientation="vertical">

    <!-- 顶部全宽深黑标题栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#212121"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按键配置向导"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 中间内容居中卡片区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 步骤序号 -->
            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="步骤 1 / 9"
                android:textColor="#0055AA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 当前要按下的按键名称提示 -->
            <TextView
                android:id="@+id/tvKeyPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="请按下【上】键"
                android:textColor="#212121"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 说明文本 -->
            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="按下物理按键后将自动进入下一步"
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- 按键即时捕获高亮提示框 -->
            <TextView
                android:id="@+id/tvCapturedInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#EAF2FC"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="等待按键按下..."
                android:textColor="#0055AA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 屏幕中间醒目的触屏跳过按钮（明显具有按钮形态与点击感） -->
            <Button
                android:id="@+id/btnSkip"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="#E0E0E0"
                android:clickable="true"
                android:focusable="false"
                android:text="👆 触屏点击跳过此键"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- 底部辅助操作栏（仅保留取消退出） -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="#212121"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="取消退出向导"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
