<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 诺基亚 S40/S60 官方调色板规范 -->
    <color name="nokia_top_bg">#303030</color>
    <color name="nokia_top_text">#FFFFFF</color>
    <color name="nokia_content_bg">#E8E8E8</color>
    <color name="nokia_content_text">#000000</color>
    <color name="nokia_content_subtext">#666666</color>
    <color name="nokia_divider">#D0D0D0</color>
    <color name="nokia_list_selected">#0055AA</color>
    <color name="nokia_list_selected_text">#FFFFFF</color>
    <color name="nokia_bottom_bg">#001166</color>
    <color name="nokia_bottom_text">#FFFFFF</color>

    <style name="Theme.NokiaKeyCore" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/nokia_content_bg</item>
        <item name="android:textColor">@color/nokia_content_text</item>
    </style>

    <!-- 诺基亚标准弹窗主题 -->
    <style name="Theme.NokiaKeyCore.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>


    <!-- Legacy compatibility colors for drawables -->
    <color name="btn_bg_normal">#DCDCDC</color>
    <color name="btn_bg_pressed">#BDBDBD</color>
    <color name="config_card">#FFFFFF</color>
    <color name="accent">#0055AA</color>
</resources>