<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#212121"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mini_shizuku 测试"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 中间可滚动内容展示区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnTestShizuku"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="执行测试 (id; whoami)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#0055AA" />

            <TextView
                android:id="@+id/tvShizukuResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E0E0E0"
                android:padding="8dp"
                android:text="点击上方按钮测试命令执行..."
                android:textColor="#222222"
                android:textSize="11sp" />

            <!-- 分隔 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#BDBDBD" />

            <!-- 权限测试区 -->
            <Button
                android:id="@+id/btnTestPermission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="#D97706"
                android:text="测试权限申请 (应用列表+手机状态)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E0E0E0"
                android:padding="8dp"
                android:text="点击上方按钮测试权限申请..."
                android:textColor="#222222"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnInstallReport"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="安装上报 (幂等，可能跳过)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#2E7D32" />

            <Button
                android:id="@+id/btnInstallReset"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="清除记录并重新上报"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#C62828" />

            <TextView
                android:id="@+id/tvInstallResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E0E0E0"
                android:padding="8dp"
                android:text="安装上报结果将显示于此。"
                android:textColor="#222222"
                android:textSize="11sp" />

            <!-- 分隔 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#BDBDBD" />

            <!-- 检查更新测试区 -->
            <Button
                android:id="@+id/btnCheckUpdateDialog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="#0055AA"
                android:text="检查更新（复古弹窗）"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCheckUpdateApi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#5A2D82"
                android:text="检查更新（纯回调 API）"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E0E0E0"
                android:padding="8dp"
                android:text="检查更新结果将显示于此。"
                android:textColor="#222222"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
